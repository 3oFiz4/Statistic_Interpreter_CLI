    # Mouse move — detect hovered stat checkbox, update desc bar
    # -------------------------------------------------------------------

    def on_mouse_move(self, event: MouseMove) -> None:
        """Detect hovered checkbox in the stats dropdown and show its description."""
        stats_dropdown = self.query_one("#stats-dropdown", DropBox)

        # Only act when the stats panel is open
        if not stats_dropdown.is_open:
            if self._last_hovered_stat is not None:
                self._last_hovered_stat = None
                stats_dropdown.update_description("")
            return

        # Find what widget is under the cursor
        try:
            widget, _ = self.screen.get_widget_at(
                event.screen_x, event.screen_y
            )
        except Exception:
            if self._last_hovered_stat is not None:
                self._last_hovered_stat = None
                stats_dropdown.update_description("")
            return

        # Walk up to find a Checkbox.dd-item
        target = widget
        found: Checkbox | None = None
        while target is not None:
            if isinstance(target, Checkbox) and target.has_class("dd-item"):
                found = target
                break
            target = getattr(target, "parent", None)

        if found is not None:
            label_text = str(found.label)
            if label_text != self._last_hovered_stat:
                self._last_hovered_stat = label_text
                desc = self._stat_descriptions.get(label_text, "")
                stats_dropdown.update_description(desc)
        else:
            if self._last_hovered_stat is not None:
                self._last_hovered_stat = None
                stats_dropdown.update_description("")

