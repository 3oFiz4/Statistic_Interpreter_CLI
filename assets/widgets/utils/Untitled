    def _rebuild_panels(self) -> None:
        if not self.classifier:
            return

        metric_keys = self.classifier.get_metric_keys()
        ordinal_keys = self.classifier.get_ordinal_keys()
        nominal_keys = self.classifier.get_nominal_keys()

